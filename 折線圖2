import matplotlib.pyplot as plt

plt.rcParams['font.sans-serif'] = ['Microsoft JhengHei'] 
plt.rcParams['axes.unicode_minus'] = False

x = [1, 3, 5, 7, 9, 11, 13, 15, 16, 17, 18, 19]
y = [0, 0.16, 0.41, 0.69, 1.02, 1.27, 1.55, 1.72, 1.8, 0, -1.96, -3.7]

plt.figure(figsize=(12, 7))

plt.plot(x, y, color='black', linestyle='-', marker='o', 
         markersize=8, markeredgecolor='white', linewidth=2, label='提升幅度(%)')

for i in range(len(x)):
    if i < len(x)-1:
        is_dropping = y[i+1] < y[i]
    else:
        is_dropping = False 

    if is_dropping or y[i] < 0:
        offset = -0.3 
        va = 'top'    
    else:
        offset = 0.3  
        va = 'bottom' 
    
    if x[i] == 17:
        offset = -0.4 

    plt.text(x[i], y[i] + offset, f'{y[i]}%', 
             ha='center',
             va=va,
             fontsize=10, 
             color='darkblue',
             fontweight='bold',
             bbox=dict(facecolor='white', alpha=0.7, edgecolor='none', pad=1))

plt.title("圖2: sigma_val為8", fontsize=16, pad=20)
plt.xlabel("s_size", fontsize=12)
plt.ylabel("精確度(IoU)提升幅度(%)", fontsize=12)

plt.axhline(0, color='gray', linewidth=1, linestyle='--')
plt.grid(True, axis='y', linestyle=':', alpha=0.5)
plt.xticks(x) 

plt.ylim(min(y) - 1.2, max(y) + 1.2) 

plt.show()
